# 1) Mapping صریح؛ title هم متن است هم مقدار exact برای sort
PUT /products-lab-v1
{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "properties": {
      "product_id": { "type": "keyword" },
      "title": {
        "type": "text",
        "fields": { "raw": { "type": "keyword" } }
      },
      "description": { "type": "text" },
      "brand": { "type": "keyword" },
      "category": { "type": "keyword" },
      "price": { "type": "long" },
      "available": { "type": "boolean" },
      "created_at": { "type": "date" },
      "tags": { "type": "keyword" },
      "offers": {
        "type": "nested",
        "properties": {
          "seller": { "type": "keyword" },
          "price": { "type": "long" },
          "stock": { "type": "integer" }
        }
      },
      "attributes": { "type": "flattened" }
    }
  }
}

# 2) Bulk؛ هر action و source سند یک خط مستقل NDJSON است
POST /_bulk?refresh=wait_for
{"index":{"_index":"products-lab-v1","_id":"sku-001"}}
{"product_id":"sku-001","title":"هدفون بی‌سیم آوا","description":"هدفون بلوتوثی سبک با حذف نویز برای رفت‌وآمد","brand":"آوا","category":"audio","price":4200000,"available":true,"created_at":"2026-01-15T10:00:00Z","tags":["bluetooth","noise-cancelling"],"offers":[{"seller":"direct","price":4200000,"stock":12},{"seller":"market-a","price":4100000,"stock":3}],"attributes":{"color":"black","connection":"bluetooth"}}
