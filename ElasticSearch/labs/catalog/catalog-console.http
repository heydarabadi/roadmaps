# 3) Full-text + filter؛ title رتبه می‌سازد، قیمت/موجودی شرط قبولی‌اند
POST /products-lab-v1/_search
{"query":{"bool":{"must":[{"match":{"title":"هدفون بی‌سیم"}}],"filter":[{"term":{"available":true}},{"range":{"price":{"lte":5000000}}}]}},"_source":["product_id","title","price","available"]}

# 4) Exact lookup روی ID کسب‌وکاری
POST /products-lab-v1/_search
{"query":{"term":{"product_id":"sku-004"}}}

# 5) Aggregation؛ دسته‌ها و میانگین قیمت، بدون برگرداندن hitها
POST /products-lab-v1/_search
{"size":0,"aggs":{"by_category":{"terms":{"field":"category","size":10},"aggs":{"average_price":{"avg":{"field":"price"}}}}}}

# 6) Nested query؛ seller و stock باید در همان offer باشند
POST /products-lab-v1/_search
{"query":{"nested":{"path":"offers","query":{"bool":{"must":[{"term":{"offers.seller":"direct"}},{"range":{"offers.stock":{"gte":5}}}]}},"inner_hits":{}}}}

# 7) Sort پایدار؛ price سپس product_id برای شکستن تساوی
POST /products-lab-v1/_search
{"size":3,"query":{"term":{"available":true}},"sort":[{"price":"asc"},{"product_id":"asc"}],"_source":["product_id","title","price"]}

# 8) Date range؛ بازه نیمه‌باز UTC [from, to)
POST /products-lab-v1/_search
{"query":{"range":{"created_at":{"gte":"2026-03-01T00:00:00Z","lt":"2026-05-01T00:00:00Z"}}}}
